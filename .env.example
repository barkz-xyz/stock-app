PORT=3000
# Server-to-server inventory API. Default disabled; keys are managed by admins in Settings.
# Enabling this in production requires PostgreSQL. Never place API keys in frontend env vars.
# INVENTORY_API_ENABLED=true
# INVENTORY_API_ENVIRONMENT=production
# Use INVENTORY_API_ENVIRONMENT=test for local/staging credentials.
# INVENTORY_RESERVATIONS_ENABLED=true
# INVENTORY_RESERVATION_TTL_SECONDS=900
# The production app must use a limited runtime role on the private hostname.
# Run migrations/provisioning separately before starting; see docs/database-roles.md.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_AUTO_MIGRATE=false
# The deployment gate requires an explicit separate database; no live URL fallback.
# TEST_DATABASE_URL=postgresql://tester:password@localhost:5432/bakery_test
# Only the separate migration runner receives these administrative settings:
# MIGRATION_DATABASE_URL=postgresql://migration_admin:password@localhost:5432/bakery
# RUNTIME_DATABASE_ROLE=bakery_runtime
# RUNTIME_DATABASE_PASSWORD=provide-through-a-secret-manager
# PROVISION_CONFIRM_DATABASE=bakery
# PROVISION_ALLOW_REMOTE=true
# External database TLS always verifies identity. Supply the trusted CA as needed.
# PGSSLROOTCERT=/protected/path/database-ca.pem
# PGSSLCERT=/protected/path/client-cert.pem
# PGSSLKEY=/protected/path/client-key.pem
# PGSSLMODE=disable is accepted only for loopback/private Railway hosts.
# Backups run outside the app on persistent protected storage; see docs/database-backups.md.
# BACKUP_DIRECTORY=/var/backups/stock-app
# BACKUP_DATABASE_URL=postgresql://backup_reader:password@localhost:5432/bakery

# Optional local JSON database location. On Railway, attach a volume and set:
# DATA_PATH=/data/inventory.json

# Optional: populate an empty local database with demonstration products.
# SEED_DEMO_DATA=true

# One-time first-admin bootstrap. Remove STAFF_PIN after provisioning the account.
# Changing STAFF_PIN never resets an existing staff password.
# SESSION_SECRET is required whenever STAFF_PIN is set. Use a long, random value.
# STAFF_PIN=1234
# SESSION_SECRET=replace-with-a-long-random-value

# Mercado Pago Point Smart 2 (production credentials and terminal ID).
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_POINT_TERMINAL_ID=...
# MERCADOPAGO_WEBHOOK_SECRET=...

# Enable the default cash through Point flow in Caja (Chile, PDV).
# Complete the cash confirmation on the terminal; fiscal printing needs the merchant's Boletas service.
# MERCADOPAGO_CASH_ENABLED=true
# IVA condition for new cash Point orders; persisted so retries send the same payload.
# MERCADOPAGO_CASH_TAX_CONDITION=payment_taxable_iva
# Use payment_exempt_iva only for a merchant selling exclusively exempt items.

# Local development only: simulate an approved Point payment without credentials.
# MERCADOPAGO_MOCK=true

# Optional override for integration testing. Production uses the default API URL.
# MERCADOPAGO_API_BASE=https://api.mercadopago.com
