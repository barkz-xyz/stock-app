# Copy outside the checkout to /etc/stock-app/backup.env, owner stock-backup,
# mode 0600. Replace placeholders using the host's secret manager.
BACKUP_DATABASE_URL=postgresql://backup_reader:REPLACE_PASSWORD@REPLACE_HOST:5432/railway
BACKUP_DIRECTORY=/var/backups/stock-app
# Required for a private CA on public database connections. Internal private
# connections may omit it. Public connections always verify the certificate.
PGSSLROOTCERT=/etc/stock-app/database-ca.pem
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_REMOTE=backup:stock-app/database
RCLONE_CONFIG=/etc/stock-app/rclone.conf
