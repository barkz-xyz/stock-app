  "components": {
    "securitySchemes": {
      "IntegrationToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque integration token",
        "description": "Token privado del backend consumidor, con vigencia, revocación y permisos por integración. Nunca en URLs o frontend. inventory:read para consultas; inventory:reserve para el ciclo de reservas."
      }
    },
    "parameters": {
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "description": "Validador HTTP obtenido de una respuesta previa. El consumidor servidor puede conservar explícitamente el ETag junto con su snapshot importado; no se habilita caché HTTP compartida. Soportar la semántica HTTP del header y verificar la autorización antes de devolver 304.",
        "schema": {
          "type": "string"
        },
        "example": "W/\"inventory-canonical-content-hash\""
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "UUID persistido antes de enviar la operación. Misma clave y cuerpo recuperan su resultado; cambiar cuerpo/acción devuelve 409. Los reintentos no extienden el plazo."
      },
      "ReservationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "PrivateNoStore": {
        "description": "La respuesta no se almacena en cachés HTTP.",
        "schema": {
          "type": "string",
          "const": "private, no-store"
        }
      },
      "VaryAuthorization": {
        "description": "Incluye Authorization y los otros valores requeridos por middleware, por ejemplo Accept-Encoding.",
        "schema": {
          "type": "string"
        },
        "example": "Authorization, Accept-Encoding"
      },
      "RequestId": {
        "description": "Identificador seguro generado/validado por el servidor para diagnóstico.",
        "schema": {
          "type": "string"
        }
      },
      "InventoryETag": {
        "description": "ETag débil de la representación canónica de este recurso. Cambia cuando cambia alguno de los datos exportados, sin depender de la hora de cada solicitud.",
        "schema": {
          "type": "string"
        },
        "example": "W/\"inventory-canonical-content-hash\""
      },
      "RetryAfter": {
        "description": "Segundos de espera o fecha HTTP según la respuesta.",
        "schema": {
          "type": "string"
        },
        "example": "30"
      },
      "AuthChallenge": {
        "description": "Desafío de autenticación Bearer.",
        "schema": {
          "type": "string"
        },
        "example": "Bearer realm=\"bakery-integrations\""
      }
    },
    "responses": {
      "NotModified": {
        "description": "Credencial válida y recurso sin cambios. No contiene body. Una clave revocada/expirada no puede obtener 304.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "ETag": {
            "$ref": "#/components/headers/InventoryETag"
          }
        }
      },
      "BadRequest": {
        "description": "La solicitud o el identificador no son válidos.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INVALID_REQUEST",
                "message": "La solicitud o el identificador no son válidos.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Falta una credencial válida de integración.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/AuthChallenge"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Falta una credencial válida de integración.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Falta el permiso exigido por la operación.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "FORBIDDEN",
                "message": "Required integration permission missing.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Producto no encontrado en el inventario autorizado.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "ITEM_NOT_FOUND",
                "message": "Producto no encontrado en el inventario autorizado.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Se excedió el límite de solicitudes.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "RATE_LIMITED",
                "message": "Se excedió el límite de solicitudes.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "No se pudo completar la consulta.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "No se pudo completar la consulta.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "Unavailable": {
        "description": "La integración está desactivada o el inventario no está disponible temporalmente.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INVENTORY_UNAVAILABLE",
                "message": "La integración está desactivada o el inventario no está disponible temporalmente.",
                "requestId": "a02e66c7-c1b1-43d5-9649-d947031fa40e"
              }
            }
          }
        }
      },
      "ReservationConflict": {
        "description": "Stock agotado, cotización modificada, idempotencia/referencia en conflicto o transición de pago/reserva no válida. Revisar error.code documentado en stock-reservations.md.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/PrivateNoStore"
          },
          "Vary": {
            "$ref": "#/components/headers/VaryAuthorization"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "DecimalQuantity": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$",
        "description": "Cantidad no negativa exacta, escala 2, punto decimal, sin miles; capacidad compatible con NUMERIC(12,2).",
        "example": "12.00"
      },
      "MoneyCLP": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999999999,
            "description": "Precio en pesos enteros CLP, sin escalar a centavos."
          },
          "currency": {
            "type": "string",
            "const": "CLP"
          }
        }
      },
      "InventoryItem": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "unit",
          "stockQuantity",
          "price",
          "sellable",
          "expiryDate",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identidad local estable; no sustituirla por SKU o nombre."
          },
          "sku": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "SKU actual; null cuando no está configurado. Su unicidad no está garantizada por el esquema actual."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Categoría actual, independiente de las traducciones de la interfaz."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Unidad actual; por ejemplo pieces o kg. No normalizar por nombre del producto ni usarla para inferir incrementos de venta."
          },
          "stockQuantity": {
            "$ref": "#/components/schemas/DecimalQuantity"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyCLP"
          },
          "sellable": {
            "type": "boolean",
            "description": "Configuración del mostrador. No indica publicación online ni una reserva confirmada."
          },
          "expiryDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Fecha de calendario del producto, sin conversión a instante UTC."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante de actualización, serializado en UTC."
          }
        }
      },
      "InventorySnapshot": {
        "type": "object",
        "required": [
          "apiVersion",
          "inventoryPoolId",
          "complete",
          "count",
          "items"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "1"
          },
          "inventoryPoolId": {
            "type": "string",
            "const": "global",
            "description": "Un único saldo global; no representa almacenes por sucursal."
          },
          "complete": {
            "type": "boolean",
            "const": true,
            "description": "Lista completa del inventario vigente. No se trunca ni filtra implícitamente."
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Debe coincidir exactamente con items.length."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InventoryItem"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "ReservationLineInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "quantity",
          "unit",
          "unitPrice"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,4})\\.[0-9]{2}$",
            "description": "Entre 0.01 y 10000.00, dos decimales obligatorios."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unitPrice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
          }
        }
      },
      "ReservationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalReference",
          "currency",
          "expectedTotal",
          "items"
        ],
        "properties": {
          "externalReference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "maxLength": 120
          },
          "currency": {
            "const": "CLP"
          },
          "expectedTotal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ReservationLineInput"
            },
            "description": "UUID únicos. Precios y unidades deben coincidir con el catálogo actual; el servidor recalcula el total."
          }
        }
      },
      "ReservationPaymentStart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paymentAttemptId"
        ],
        "properties": {
          "paymentAttemptId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReservationConfirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paymentAttemptId",
          "paymentReference",
          "amount",
          "currency"
        ],
        "properties": {
          "paymentAttemptId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentReference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "maxLength": 120
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
          },
          "currency": {
            "const": "CLP"
          }
        }
      },
      "ReservationRelease": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "checkout_cancelled",
              "payment_rejected",
              "payment_cancelled",
              "payment_not_created"
            ]
          },
          "paymentAttemptId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcomeVerified": {
            "type": "boolean"
          }
        },
        "description": "payment_pending exige paymentAttemptId coincidente, outcomeVerified=true y una razón de pago (no checkout_cancelled). El backend consumidor debe verificar primero el resultado con el proveedor."
      },
      "StockReservation": {
        "type": "object",
        "required": [
          "id",
          "externalReference",
          "status",
          "total",
          "inventoryApplied",
          "expiresAt",
          "createdAt",
          "updatedAt",
          "paymentAttemptId",
          "paymentReference",
          "releaseReason",
          "paymentStartedAt",
          "confirmedAt",
          "releasedAt",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "externalReference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "maxLength": 120
          },
          "status": {
            "enum": [
              "held",
              "payment_pending",
              "confirmed",
              "released",
              "expired"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/MoneyCLP"
          },
          "inventoryApplied": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "paymentAttemptId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "paymentReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "paymentStartedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "confirmedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "releasedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "name",
                "unit",
                "quantity",
                "unitPrice",
                "lineTotal"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,4})\\.[0-9]{2}$",
                  "description": "Entre 0.01 y 10000.00, dos decimales obligatorios."
                },
                "unitPrice": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999999
                },
                "lineTotal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999999
                }
              }
            }
          },
          "replayed": {
            "type": "boolean",
            "description": "Presente en escrituras; indica reintento con la misma clave. La respuesta devuelve el estado actual."
          }
        }
      }
    }
  }
}
