{
  "openapi": "3.1.0",
  "info": {
    "title": "Bakery POS API de inventario y reservas",
    "version": "1.1.0",
    "description": "API privada entre servidores. Lectura con inventory:read; reservas con inventory:reserve, PostgreSQL e INVENTORY_RESERVATIONS_ENABLED=true. El checkout separado conserva pedidos, compradores y pagos. Ver inventory-api.md y stock-reservations.md."
  },
  "x-status": "implemented",
  "x-prepared-at": "2026-10-20",
  "x-inventory-semantics": "stockQuantity es items.quantity: saldo neto disponible, con ventas y reservas Point/online ya descontadas. Confirmar una reserva no descuenta otra vez. Liberar o vencer restituye una sola vez.",
  "servers": [
    {
      "url": "/",
      "description": "Origen del backend Bakery POS."
    }
  ],
  "security": [
    {
      "IntegrationToken": []
    }
  ],
  "tags": [
    {
      "name": "Inventory",
      "description": "Sólo lectura; permiso inventory:read verificado en cada solicitud."
    },
    {
      "name": "Reservations",
      "description": "Permiso inventory:reserve. Apartado inicial de 900 s; payment_pending no vence automáticamente. Reconciliar pagos en el checkout antes de liberar."
    }
  ],
  "paths": {
    "/api/integrations/v1/inventory": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "operationId": "getInventorySnapshot",
        "summary": "Consultar todo el inventario vigente",
        "description": "Snapshot completo de una única lectura consistente, ordenado por UUID. Incluye stock cero, sellable=false y SKU faltante. No admite filtros ni páginas en esta primera entrega. count se obtiene de los mismos items enviados. Un fallo de base de datos es un error, no un array vacío. El cliente debe ignorar campos adicionales futuros. Evaluar If-None-Match sólo después de autenticar y autorizar; la representación no contiene timestamps generados por petición.",
        "x-required-scopes": [
          "inventory:read"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot completo. complete=true también cuando el inventario está realmente vacío.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/PrivateNoStore"
              },
              "Vary": {
                "$ref": "#/components/headers/VaryAuthorization"
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              },
              "ETag": {
                "$ref": "#/components/headers/InventoryETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySnapshot"
                },
                "example": {
                  "apiVersion": "1",
                  "inventoryPoolId": "global",
                  "complete": true,
                  "count": 1,
                  "items": [
                    {
                      "id": "8f39e7d9-73fd-43aa-8dd1-24a97a3fdc88",
                      "sku": "PP-002",
                      "name": "ALIADO AMASADO JAMON/QUESO",
                      "category": "Bread",
                      "unit": "pieces",
                      "stockQuantity": "12.00",
                      "price": {
                        "amount": 1200,
                        "currency": "CLP"
                      },
                      "sellable": true,
                      "expiryDate": null,
                      "updatedAt": "2026-10-20T17:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "304": {
            "$ref": "#/components/responses/NotModified"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "405": {
            "description": "Sólo se admite GET. Incluye Allow: GET.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
