{
  "name": "bakery-counter-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "build:deploy": "npm run check && npm run build",
    "test:deploy": "node scripts/test-deploy.js",
    "predeploy:railway": "npm run test:deploy && npm run check:database",
    "validate": "npm run build:deploy && npm run test:deploy",
    "start": "node server/index.js",
    "check": "node scripts/check-source.js",
    "seed:week": "node scripts/seed-week-demo.js",
    "seed:week:postgres": "node scripts/seed-week-postgres.js",
    "backup:postgres": "node scripts/backup-postgres.js",
    "audit:postgres": "node scripts/audit-postgres.js",
    "smoke:production": "node scripts/smoke-production.js",
    "measure:load": "node scripts/measure-load.js",
    "measure:inventory": "node scripts/measure-inventory.js",
    "audit:performance:db": "node scripts/audit-performance-db.js",
    "verify:cdn": "node scripts/verify-cdn.js",
    "import:catalog": "node scripts/import-sheet-catalog.js",
    "verify:postgres": "node scripts/verify-postgres-sale-batch.js",
    "test": "node --test --test-concurrency=1 server/*.test.js",
    "restore:postgres": "node scripts/restore-postgres.js",
    "test:backup": "node --test scripts/backup-postgres.test.js",
    "backup:offsite": "bash scripts/backup-postgres-offsite.sh",
    "migrate:postgres": "node scripts/migrate-postgres.js",
    "provision:postgres": "node scripts/provision-postgres.js",
    "check:database": "node scripts/check-postgres.js",
    "test:tls": "node --test scripts/postgres-tls.test.js",
    "test:roles": "node --test scripts/database-role.test.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mercadopago": "^3.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.3.7"
  }
}
